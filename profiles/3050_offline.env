# RTX 3050 6 ГБ, ЛОКАЛЬНЫЕ ТЕСТЫ (не для жюри): Qwen3-VL-4B GGUF Q4_K_M через Ollama
# (qwen3-vl:4b-instruct в Ollama — это Q4_K_M), 1–3 кадра на запрос, кадры 640 px,
# Следопыт (YOLOX + RTMPose) работает ДО Qwen, а не одновременно с ним. Основной L4-пайплайн не затронут.
BACKEND=ollama
VLM_URL=http://127.0.0.1:11434/v1/chat/completions
VLM_MODEL=qwen3-vl:4b-instruct
VLM_MAX_IMAGES=3
WIN_SEC=3
STRIDE_SEC=3
SCAN_FRAMES=3
VERIFY_SEC=3
VERIFY_FRAMES=3
VOTES=1
MAX_SIDE=640
CACHE_SIDE=768
PARALLEL=1
OLLAMA_CTX=4096
OLLAMA_FLASH=1
OLLAMA_KV=q8_0
MOTION_T=1.5
POSE_FPS=3
POSE_DEVICE=cpu
POSE_MODE=lightweight
POSE_SEQUENTIAL=1
OBJ_DET_MODEL=yolox_tiny.onnx
VIS_ENABLED=0
# офлайн-режим: без лимита жюри, ошибки модели не роняют задачу (решение по правилам с пометкой unverified)
TIME_BUDGET=1200
FAIL_ON_VLM_DOWN=0
