# Ноутбук-сервер: RTX 4050 6 ГБ. Qwen3-VL-4B через Ollama, RTMPose на GPU.
BACKEND=ollama
VLM_URL=http://127.0.0.1:11434/v1/chat/completions
VLM_MODEL=qwen3-vl:4b-instruct
STRIDE_SEC=3
SCAN_FRAMES=6
VERIFY_SEC=4
VERIFY_FRAMES=8
VOTES=1
MAX_SIDE=512
CACHE_SIDE=720
PARALLEL=2
OLLAMA_CTX=6144
# 6 ГБ: flash attention + кэш q8_0, иначе 2 параллельных запроса не влезают в видеопамять
OLLAMA_FLASH=1
OLLAMA_KV=q8_0
MOTION_T=1.5
POSE_FPS=3
POSE_DEVICE=auto
TIME_BUDGET=270
OBJ_DET_MODEL=yolox_tiny.onnx
VIS_ENABLED=0
