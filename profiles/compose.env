# docker compose (L4 24 ГБ): vLLM с параметрами из ТЗ — gpu-memory-utilization 0.60, max-model-len 8192,
# max-num-seqs 2, до 8 картинок в запросе. Остальная видеопамять — YOLOX/RTMPose в контейнере worker.
# Профиль l4 (start.sh на RunPod) настроен быстрее: 16 картинок, 32 запроса параллельно.
BACKEND=vllm
VLM_MODEL=qwen
VLM_MAX_IMAGES=8
STRIDE_SEC=2
SCAN_FRAMES=8
VERIFY_SEC=5
VERIFY_FRAMES=8
VOTES=2
MAX_SIDE=640
CACHE_SIDE=960
PARALLEL=4
WORKERS=1
MOTION_T=1.0
POSE_FPS=5
POSE_MODE=balanced
POSE_DEVICE=auto
OBJ_DET_MODEL=yolox_s.onnx
VIS_ENABLED=1
TIME_BUDGET=240
