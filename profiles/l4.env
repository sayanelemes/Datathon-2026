# RunPod: 1x NVIDIA L4 24 ГБ, 55 ГБ RAM, 6 vCPU (шаблон vllm-latest). Qwen3-VL-8B FP8 через vLLM, RTMPose на GPU.
BACKEND=vllm
VLM_URL=http://127.0.0.1:18001/v1/chat/completions
VLM_MODEL=qwen
HF_REPO=Qwen/Qwen3-VL-8B-Instruct-FP8
MODEL_DIR=/workspace/models/qwen3vl8b_fp8
# память vLLM: ~10 ГБ веса + кэш; остаток (~5 ГБ) — RTMPose и запас
GPU_UTIL=0.78
MAX_LEN=16384
MAX_NUM_SEQS=32
# шаг 3 с при окне 4 с — окна всё ещё перекрываются; запас времени под кадры в исходном разрешении
STRIDE_SEC=3
SCAN_FRAMES=8
VERIFY_SEC=5
VERIFY_FRAMES=12
VOTES=2
# видео датасета 464×848: скан — в исходном разрешении, перепроверка — с увеличением (≈10,5 тыс. токенов на 12 кадров)
MAX_SIDE=848
VERIFY_SIDE=1280
CACHE_SIDE=1280
PARALLEL=16
# два видео одновременно: жюри может отправить несколько сразу, а лимит 5 минут считается от загрузки
WORKERS=2
MOTION_T=1.0
POSE_FPS=5
POSE_MODE=balanced
POSE_DEVICE=auto
TIME_BUDGET=240
# Следопыт: YOLOX COCO (телефоны, предметы) на GPU; видео с разметкой рисуется после ответа
OBJ_DET_MODEL=yolox_s.onnx
VLM_MAX_IMAGES=16
VIS_ENABLED=1
# решение (tools/tune.py, прогон 18.10 01:20): «уверенный скан» без подтверждения давал ложные тревоги — выключен;
# нарушения «по бездействию» — только при очень уверенном «да»
STRONG=1.01
TYPE_THRESH=NO_RECOUNT_IN_FRONT=0.9,PAYOUT_NO_RECOUNT=0.9,BAG_ACCEPTED_NO_CHECK=0.9
