# Эксперимент на той же L4 24 ГБ: Qwen3-VL-30B-A3B (AWQ, ~17 ГБ). Сравнить с l4 через tools/eval_api.py.
BACKEND=vllm
VLM_URL=http://127.0.0.1:18001/v1/chat/completions
VLM_MODEL=qwen
HF_REPO=QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ
MODEL_DIR=/workspace/models/qwen3vl30b_awq
GPU_UTIL=0.88
MAX_LEN=12288
MAX_NUM_SEQS=16
STRIDE_SEC=2
SCAN_FRAMES=8
VERIFY_SEC=5
VERIFY_FRAMES=12
VOTES=2
MAX_SIDE=640
CACHE_SIDE=960
PARALLEL=8
WORKERS=2
MOTION_T=1.0
POSE_FPS=4
# видеопамяти почти не остаётся — RTMPose на CPU в лёгком режиме
POSE_MODE=lightweight
POSE_DEVICE=cpu
TIME_BUDGET=240
OBJ_DET_MODEL=yolox_tiny.onnx
VLM_MAX_IMAGES=16
VIS_ENABLED=1
