# L4 24 ГБ: Qwen3-VL-30B-A3B (AWQ, ~17 ГБ) — сильнее 8B на мелких деталях, по скорости близко (≈3 млрд активных параметров).
# Сравнить с l4 через tools/eval_api.py + tools/tune.py. Веса — на диске контейнера (быстрая загрузка):
#   python3 -c "from huggingface_hub import snapshot_download as d; d('QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ', local_dir='/root/models/qwen3vl30b_awq')"
BACKEND=vllm
VLM_URL=http://127.0.0.1:18001/v1/chat/completions
VLM_MODEL=qwen
HF_REPO=QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ
MODEL_DIR=/root/models/qwen3vl30b_awq
# 17 ГБ весов: почти вся видеопамять — vLLM (RTMPose на CPU), кэш в FP8 (вдвое меньше; L4 поддерживает)
GPU_UTIL=0.94
KV_DTYPE=fp8
MAX_LEN=12288
MAX_NUM_SEQS=16
# окно 4 с, шаг 3 с; кадры датасета 464×848 — скан в исходном разрешении (≈3,2 тыс. токенов на окно)
STRIDE_SEC=3
SCAN_FRAMES=8
VERIFY_SEC=5
VERIFY_FRAMES=12
VOTES=2
MAX_SIDE=848
# перепроверка с увеличением до 1024: 12 кадров ≈ 7 тыс. токенов — влезает в MAX_LEN 12288
VERIFY_SIDE=1024
CACHE_SIDE=1280
PARALLEL=8
WORKERS=2
MOTION_T=1.0
POSE_FPS=4
# видеопамяти почти не остаётся — RTMPose и YOLOX на CPU в лёгком режиме
POSE_MODE=lightweight
POSE_DEVICE=cpu
TIME_BUDGET=240
OBJ_DET_MODEL=yolox_tiny.onnx
VLM_MAX_IMAGES=12
VIS_ENABLED=1
STRONG=1.01
TYPE_THRESH=NO_RECOUNT_IN_FRONT=0.9,PAYOUT_NO_RECOUNT=0.9,BAG_ACCEPTED_NO_CHECK=0.9
