# Скопируйте в .env и заполните. Переменные окружения важнее профилей и YAML.
# Комментарии — только на отдельных строках (docker compose читает «X= # …» как значение).

# --- обязательно ---
# ключ X-API-Key для жюри: ≥16 символов, иначе сервис не запустится. Сгенерировать:
#   python3 -c "import secrets; print('2mp-' + secrets.token_urlsafe(24))"
API_KEY=

# --- модель ---
# что запускает vLLM в docker compose (FP8: 8B помещается в 0.60 × 24 ГБ)
QWEN_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
# токен Hugging Face не нужен для открытых весов Qwen
HF_TOKEN=
# адрес vLLM: compose задаёт сам (http://vllm:8000/v1); start.sh использует VLM_URL
# VLLM_URL=http://vllm:8000/v1
# без модели — только интерфейс и демо
# VLM_MOCK=1

# --- ответ API ---
# 1 — добавить confidence, legal_reference, legal_confidence, object_type, verification,
# annotated_video_url (это шире ТЗ; жюри проверяет строгий набор полей — по умолчанию 0)
API_EXTENDED=0

# --- пути (в Docker уже заданы) ---
# DATA_DIR=jobs
# UPLOAD_DIR=uploads
# RESULTS_DIR=results
# MODELS_DIR=models
# LEGAL_BASE_DIR=legal_base
# CAMERA_CONFIG=configs/camera_1.yaml
# RULES_CONFIG=configs/rules.yaml
# VIOLATIONS_PATH=configs/violations.yaml
# пусто — очередь в памяти процесса (RunPod / ноутбук); compose задаёт redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# --- поведение ---
# видео с разметкой results/{job_id}_annotated.mp4
# VIS_ENABLED=1
# --- данные (безопасность) ---
# через сколько часов удалять задачи целиком; 0 — не удалять
# RETENTION_HOURS=72
# 1 — не удалять исходное видео после анализа
# KEEP_VIDEO=0
# 1 — рисовать видео с разметкой и для задач жюри (по умолчанию только для загрузок с сайта)
# VIS_FOR_API=0
# лимиты загрузок с сайта: в очереди одновременно / с одного адреса в час
# WEB_MAX_PENDING=3
# WEB_PER_IP_HOUR=10
# 0 — при недоступном Qwen отдавать нарушения по правилам с пометкой unverified (по умолчанию — failed)
# FAIL_ON_VLM_DOWN=1
# USE_LEGAL_RAG=1
# путь к скачанной модели sentence-transformers (иначе встроенный hash-tfidf)
# LEGAL_EMBED_MODEL=
# PORT=8000
# LOG_LEVEL=INFO
